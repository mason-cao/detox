# Phase 2+ cloud tier environment variables.
# Copy to infra/.env and fill in. Not read by the v1 agent.

# --- Database ---
# Local dev (docker-compose.dev.yml):
DATABASE_URL=postgresql://detox:detox@localhost:5432/detox

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Clerk) ---
# Get these from https://dashboard.clerk.com after creating an app.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- FastAPI ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5050,http://localhost:3000

# --- Deployment (Phase 4) ---
# FLY_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
